# ===========================================================================
# MARS API — Garcar Enterprise canonical keys
# Matches systems-master-hub/vault/.vault.env.template + AutoKey standard
# Copy to .env (never commit) or set in Railway / GitHub Actions secrets
# ===========================================================================

# ── Payment Runtime Plane ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Shared App Plane ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
APP_URL=

# ── Webhooks / Fan-out ──────────────────────────────────────────────────────
ZAPIER_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
ORCHESTRATOR_WEBHOOK_URL=
# alias also accepted: MARS_WEBHOOK_URL

# ── AI / Orchestration (optional for agent endpoints) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
GITHUB_TOKEN=

# ── Deploy (usually set by platform) ────────────────────────────────────────
# RAILWAY_TOKEN=
# PORT=
